    "Download songs only when connected to Wi-Fi." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa les peces només quan s'estigui connectat a una xarxa Wi-Fi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stahovat písně jen při připojení k síti Wifi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lieder nur herunterladen, wenn mit einen WLAN-Netzwerk verbunden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λήψη τραγουδιών μόνο όταν είστε συνδεδεμένοι σε ένα δίκτυο Wi-Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo descargar canciones mientras está conectado a una red wifi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lataa kappaleet vain wifi-yhteydellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharger les morceaux uniquement lorsque connecté à un réseau Wifi."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzmi pjesme samo kada je povezana WI-FI mreža."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A számok csak WiFi hálózaton töltődjenek le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica i brani solo quando connesso a una rete Wi-Fi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WiFi ネットワークに接続したときのみ、曲をダウンロードします。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სიმღერების ჩამოტვირთვა, მხოლოდ wifi კავშირის არსებობის დროს."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음악 다운로드는 Wifi 네트워크에 연결 되었을 때에만 가능합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atsisiųsti dainas tik tuomet, kai yra prisijungta prie belaidžio tinklo."
          }
        },
        "ms" : {
