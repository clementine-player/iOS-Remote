    "Download songs, albums and playlists from the player, the queue and the library. They're saved in the Files app." : {
      "localizations" : {
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laadi pleierist, esitusjärjekorrast ja muusikakogust alla lugusid, albumeid ja esitusloendeid. Nad salvestuvad failirakenduses."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lataa kappaleita, albumeita ja soittolistoja soittimesta, jonosta ja kirjastosta. Ne tallennetaan Tiedostot-sovelluksella."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica brani, album e scalette dal lettore, dalla coda e dalla raccolta. Vengono salvati nell'applicazione File."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачивайте песни, альбомы и плейлисты из проигрывателя, очереди и фонотеки. Они сохраняются в приложении «Файлы»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hämta låtar, album och spellistor från spelaren, kön och musikbiblioteket. De sparas i appen Filer."
          }
        }
      }
    },
