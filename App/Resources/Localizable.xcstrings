    "This phone doesn't have a local network address. Try turning off \"Use only local IP addresses\" in Clementine's settings." : {
      "localizations" : {
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sel nutiseadmel on kohtvõrgule mitteomane IP-aadress. Proovi lülitada Clementine'i seadistustest välja valik „Kasuta vaid kohalikke IP-aadresse“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puhelimella ei ole lähiverkko-osoitetta. Kokeile poistaa käytöstä ”Käytä vain paikallisia IP-osoitteita” -asetus Clementinen asetuksista."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этого телефона нет адреса в локальной сети. Попробуйте отключить «Использовать только локальные IP-адреса» в настройках Clementine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonen har ingen lokal nätverksadress. Prova att avaktivera ”Använd endast lokala IP-adresser” i Clementines inställningar."
          }
        }
      }
    },
    "This phone isn't on Wi-Fi. Connect to the same network as Clementine. To reach Clementine over the internet, forward its port and turn off \"Use only local IP addresses\" in Clementine's settings." : {
      "localizations" : {
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See nutiseade pole WiFi võrgus. Ühenda ta Clementine'iga samasse võrku. Kui soovid ligipääsu internetist, siis seadista ruuterist pordi suunamine ja lülita Clementine'i seadistustest välja valik „Kasuta vaid kohalikke IP-aadresse“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puhelin ei ole wifi-verkossa. Yhdistä samaan verkkoon kuin Clementine. Jos haluat käyttää Clementineä internetin välityksellä, tee portin edelleenohjaus ja poista Clementinen asetuksista valinta ”Käytä vain paikallisia IP-osoitteita”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот телефон не подключён к Wi-Fi. Подключитесь к той же сети, что и Clementine. Чтобы связаться с Clementine через интернет, перенаправьте его порт и отключите «Использовать только локальные IP-адреса» в настройках Clementine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonen är inte ansluten till wifi. Anslut till samma nätverk som Clementine. För att nå Clementine över internet behöver du vidarebefordra programmets port och avaktivera ”Använd endast lokala IP-adresser” i Clementines inställningar."
          }
        }
      }
    },
