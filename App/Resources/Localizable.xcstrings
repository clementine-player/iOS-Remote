          "stringUnit" : {
            "state" : "translated",
            "value" : "음악 다운로드는 Wifi 네트워크에 연결 되었을 때에만 가능합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
