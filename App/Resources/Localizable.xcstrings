    "Find music in your library and in Clementine's internet services.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriviu els termes de cerca per trobar peces al vostre ordinador o en Internet"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte hledané pojmy výše pro hledání hudby ve vašem počítači a na internetu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben Suchbegriffe eingeben, um Musik auf Ihrem Rechner oder im Internet zu finden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba términos de búsqueda más arriba para encontrar música en el equipo y en la Internet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna hakuehdot yläpuolella löytääksesi musiikkia tietokoneeltasi ja internetistä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisir vos critères de recherche au dessous pour trouver la musique sur votre ordinateur ou sur internet"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upišite izraz pretrage iznad za pronalazak glazbe na vašem računalu i Internetu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írja be a keresési kifejezéseit a számítógépén és az interneten található zenék kereséséhez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci i termini di ricerca per trovare la musica sul tuo computer e su internet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのコンピュータからインターネット上の音楽を見つけるために、上に検索する言葉を入力してください"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įrašykite paieškos žodžius, kad rastumėte muziką savo kompiuteryje ar internete"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan terma gelintar di atas untuk mencari muzik dalam komputer anda dan juga di internet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer zoektermen hierboven in om muziek te zoeken op je computer en het internet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj kryteria wyszukiwania aby znaleźć muzykę na twoim komputerze oraz w internecie"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza os termos da pesquisa para procurar músicas no seu computador e na Internet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите ключевое слово выше, чтобы найти музыку на вашем компьютере или в интернет"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyššie zadajte hľadané frázy na nájdenie hudby vo vašom počítači a na internete"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Унесите изнад термине за претрагу да бисте пронашли музику на вашем рачунару и на интернету"
          }
        },
        "sv": {
          "stringUnit": {
