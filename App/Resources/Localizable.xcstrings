    "Clementine only accepts connections from its local network." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine přijímá pouze připojení z vlastní místní sítě."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine solo acepta conexiones de su red local."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine lubab ühendusi vaid kohtvõrgust."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine hyväksyy yhteyksiä vain lähiverkosta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine accetta connessioni solo dalla sua rete locale."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine hanya menerima sambungan daripada rangkaian setempat sahaja."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine принимает подключения только из своей локальной сети."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine tillåter bara anslutningar från sitt lokala nätverk."
          }
        }
      }
    },
    "Clementine only accepts connections from its local network. To connect from elsewhere, turn off \"Only allow connections from the local network\" in its Network Remote settings." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Clementine přijímá pouze připojení z místní sítě. Chcete-li se připojit z jiného místa, vypněte v nastavení pro síťové vzdálené ovládání volbu Povolit spojení pouze z místní sítě."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine lubab ühendusi vaid kohtvõrgust. Ühendamiseks mujalt lülita Clementine seadistuste kaugjuhtimispuldi alajaotusest välja eelistus „Luba ühendusi vaid kohtvõrgust“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine hyväksyy yhteyksiä vain lähiverkosta. Jos haluat muodostaa yhteyden muualta, poista käytöstä asetus ”Salli yhteydet vain lähiverkosta” ohjelman verkko- ja etäkäyttöasetuksista."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine accetta connessioni solo dalla rete locale. Per connettersi da altrove, disabilita l'opzione \"Consenti connessioni solo dalla rete locale\" nelle impostazioni di controllo remoto tramite rete."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine принимает подключения только из своей локальной сети. Чтобы подключиться извне, отключите «Разрешать подключения только из локальной сети» в настройках удалённого управления по сети."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine tillåter bara anslutningar från sitt lokala nätverk. För att ansluta från annat håll avaktiverar du ”Tillåt endast anslutningar från det lokala nätverket” under Nätverksfjärrkontroll i inställningarna."
          }
        }
      }
    },
    "Clementine plays on its computer, or sends its music to a device that's connected to it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine přehrává hudbu v počítači nebo ji odesílá do zařízení, které je k němu připojeno."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine võib lugusid esitada arvutis või edastada seda nutiseadmesse, millega ta on ühendatud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine toistaa musiikkia tietokoneella tai lähettää sitä tietokoneeseen liitetylle laitteelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine riproduce musica sul computer o la invia a un dispositivo a esso collegato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine воспроизводит музыку на своём компьютере или отправляет её на устройство, подключённое к нему."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine spelar upp musik på datorn eller skickar den till en enhet som är ansluten till programmet."
          }
        }
      }
    },
    "Clementine refused the connection" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine odmítla spojení"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine rechazó la conexión"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine keeldus ühendusest"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine kieltäytyi yhteydestä"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine ha rifiutato la connessione"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine menolak sambungan"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine отклонил подключение"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine nekade anslutningen"
          }
        }
      }
    },
    "Clementine stopped answering. Check that it's still running, then connect again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine přestala odpovídat. Prověřte, zda je zařízení stále v provozu, a pak je znovu připojte."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine ei vasta enam päringutele. Kontrolli, et ta veel töötab ja ühenda siis uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine lakkasi vastaamasta. Tarkista, että se on yhä käynnissä ja muodosta sitten yhteys uudelleen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine ha smesso di rispondere. Verifica che sia ancora in esecuzione, poi riconnettiti."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine berhanti menmbalas, Periksa sama ada ia masih berjalan, kemudian sambung sekali lagi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine перестал отвечать. Проверьте, что он всё ещё запущен, и подключитесь снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine slutade svara. Kontrollera att programmet fortfarande körs och anslut sedan igen."
          }
        }
      }
    },
    "Clementine volume" : {
      "localizations" : {
        "cs" : {
