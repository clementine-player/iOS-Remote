    "Is Clementine running? Is it version %@ or later, with the network remote turned on in its settings? Is the address right?" : {
      "localizations" : {
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas Clementine töötab arvutis? Kas tema versioon on %@ või uuem ning kaugjuhtimispuldi kasutamine on seadistustest lubatud? Kas aadress ikka on õige?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onko Clementine käynnissä? Onko versio %@ tai uudempi ja kauko-ohjaus kytketty päälle asetuksista? Onko osoite oikein?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine è in esecuzione? Si tratta della versione %@ o successiva, con il controllo remoto di rete attivato nelle impostazioni? L'indirizzo è corretto?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine запущен? Это версия %@ или более поздняя, с включённым удалённым доступом по сети в его настройках? Адрес указан верно?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Körs Clementine? Är det version %@ eller senare, med nätverksfjärrkontrollen aktiverad i inställningarna? Är adressen rätt?"
          }
        }
      }
    },
