    "That address is on your network, and Clementine Remote needs Local Network access to reach it. Turn on Local Network in Settings." : {
      "localizations" : {
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See aadress asub sinu võrgus ja Clementine'i kaugjuhtimispult vajaf ligipääsuks õigust kasutada kohtvõrku. Lülita see võimalus seadistustest sisse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä osoite on verkossasi ja Clementine Remote tarvitsee pääsyn lähiverkkoosi. Ota lähiverkko käyttöön asetuksista."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quell'indirizzo si trova sulla tua rete e Clementine Remote necessita dell'accesso alla rete locale per raggiungerlo. Attiva la rete locale nelle Impostazioni."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
