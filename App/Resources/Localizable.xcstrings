    "Not showing up? Check that its network remote is turned on, or enter its address below." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿No aparece? Cerciórese de que el mando de red esté activado o introduzca su dirección:"
