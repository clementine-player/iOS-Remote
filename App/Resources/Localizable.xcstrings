    "Wi-Fi and mobile data, not in Low Data Mode" : {
      "comment" : "A choice under Download over: Wi-Fi, and mobile data unless Low Data Mode is on."
    },
    "Wi-Fi only" : {
      "comment" : "A choice under Download over. A metered Wi-Fi, such as another phone's hotspot, counts as mobile data."
    },
    "Without Local Network access, Clementine Remote can't find Clementine on your network. Enter its address below, or turn on Local Network in Settings." : {
      "localizations" : {
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui ligipääs kohtvõrgule on puudu, siis Clementine'i kaugjuhtimispult ei suuda Clementine'iga arvutit sinu võrgust leida. Sisesta alljärgnevas vajalik aadress või luba seadistustest kohtvõrgu kasutamine."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilman lähiverkon oikeutta Clementine Remote ei löydä Clementinea verkosta. Kirjoita sen osoite alle tai ota lähiverkko käyttöön asetuksista."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без доступа к локальной сети Clementine Remote не может найти Clementine в вашей сети. Введите его адрес ниже или включите доступ к локальной сети в настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan åtkomst till lokalt nätverk kan Clementine Remote inte hitta Clementine i ditt nätverk. Ange adressen nedan eller aktivera Lokalt nätverk i Inställningar."
          }
        }
      }
    },
