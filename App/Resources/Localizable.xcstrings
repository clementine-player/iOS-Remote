        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λήψη απαγορεύεται. Ενεργοποίηση στις ρυθμίσεις του Clementine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha restringido la descarga. Actívela en la configuración de Clementine."
