    "Clementine doesn't allow downloads. Turn them on in its Network Remote settings." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixada no autoritzada. Es pot activar a la configuració del Clementine."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stahování zakázáno. Zapněte je v nastavení Clementine."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herunterladen verboten. In den Clementine-Einstellungen aktivieren."
