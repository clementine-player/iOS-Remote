    "Plays Clementine if it's paused, and pauses it if it's playing." : {
      "localizations" : {
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esitab Clementine'ist kui esitus on peatatud ja peatab, kui on esitamisel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toistaa Clementineä, jos se on keskeytetty ja keskeyttää toiston, jos se on käynnissä."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускает проигрывание в Clementine, если он на паузе, и ставит на паузу, если он играет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startar uppspelningen i Clementine om den är pausad och pausar den om den pågår."
          }
        }
      }
    },
    "Plays it, or adds it to the playlist if Clementine is playing" : {
      "localizations" : {
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esitab seda või kui Clementine esitab midagi, siis lisab esitusloendisse"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toistaa sen tai lisää sen soittolistalle, jos Clementine on parhaillaan toistamassa musiikkia"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизводит его или добавляет в плейлист, если Clementine играет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelar upp det eller lägger till det i spellistan om Clementine redan spelar"
          }
        }
      }
    },
    "Please update Clementine. You need Clementine %@ or later." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si us plau, actualitzeu el Clementine! Necessiteu la versió %1$@ o posterior."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizujte Clementine! Potřebujete Clementine %1$@ nebo novější."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte Clementine aktualisieren! Sie benötigen Clementine %1$@ oder höher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualice Clementine. Necesita Clementine %@ o posterior."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palun uuenda arvutis Clementine'i versiooni. Selle versioon peaks olema %@ või hilisem."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivitä Clementine! Tarvitset Clementinen %@ tai uudemman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci de mettre à jour Clementine ! La version de Clementine %1$@ ou supérieure est nécessaire."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadopunite Clementine! Potreban vam je Clementine %1$@ ili noviji."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérjük frissítse a Clementine-t! A Clementine %1$@ vagy újabb szükséges."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna Clementine! Hai bisogno di Clementine %1$@ o versione successiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine を更新してください! Clementine %1$@ 以降が必要です。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prašome atnaujinti Clementine! Jums reikia Clementine %1$@ arba naujesnės versijos."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sila kemaskini Clementine! anda perlukan Clementine %1$@ atau yang terkemudian."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Clementine aub! U heeft Clementine %1$@ of hoger nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proszę uaktualnić Clementine! Potrzebujesz Clementine w wersji %1$@ lub późniejszej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor atualize o Clementine. Necessita, no mínimo, da versão %1$@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor atualize o Clementine. Necessita, no mínimo, da versão %1$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пожалуйста, обновите Clementine! Требуется версия Clementine %1$@ или выше."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosím, aktualizujte prehrávač Clementine! Vyžaduje sa prehrávač Clementine vo verzii %1$@ alebo novšej."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надоградите Клементину! Потребна вам је Клементина %1$@ или новија."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdatera Clementine. Du behöver Clementine %@ eller senare."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь ласка, встановіть новішу версію Clementine! Для роботи потрібна Clementine %1$@ або новіша."
          }
        }
      }
    },
