        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine hetkel ei luba allalaadimist. Saad selle Clementine'i kaugjuhtimisliidese seadistustes lubada."
          }
        },
        "fi" : {
          "stringUnit" : {
