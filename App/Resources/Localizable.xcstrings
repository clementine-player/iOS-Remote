    "Clementine won't check another auth code from this phone for %@. Then enter the code shown in its Network Remote settings." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine z tohoto telefonu již nebude ověřovat žádný další autorizační kód po %@. Poté zadejte kód zobrazený v nastavení pro síťové vzdálené ovládání."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine ei tarkista toista todennuskoodia tästä puhelimesta %@. Anna asetuksissa näkyvä koodi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine non richiederà un altro codice di autenticazione da questo telefono per %@. Successivamente, digita il codice mostrato nelle impostazioni di controllo remoto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clementine не будет проверять последующие коды аутентификации с этого телефона в течение %@. Затем введите код, показанный в настройках удалённого управления по сети."
          }
        }
      }
    },
