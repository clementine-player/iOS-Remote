    "Clementine doesn't allow downloads. Turn them on in its Network Remote settings.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixada no autoritzada. Es pot activar a la configuració del Clementine."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stahování zakázáno. Zapněte je v nastavení Clementine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Herunterladen verboten. In den Clementine-Einstellungen aktivieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λήψη απαγορεύεται. Ενεργοποίηση στις ρυθμίσεις του Clementine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha restringido la descarga. Actívela en la configuración de Clementine."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Allalaadimine keelatud. Aktiveeri Clementine'i seadetes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataaminen on kielletty. Aktivoi lataaminen Clementinen asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement interdit. Vous pouvez l'activer dans les préférences de Clementine."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzimanje zabranjeno. Aktivirajte ga u Clementine postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Letöltés tiltva, aktiválja a Clementine beállításaiban"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download Proibito. Attivalo nelle impostazioni di Clementine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードが禁止されています。Clementine の設定で有効にしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩამოტვირთვა აკრძალულია. გააქტიურეთ ის Clementine-ის პარამეტრებში."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 금지됨. Clementine 설정에서 활성화"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsiuntimas uždraustas. Aktyvuokite Clementine nustatymuose."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat turun dilarang. Aktifkan dalam tetapan Clementine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download niet toegestaan. Activeer in Clementine instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieranie zabronione. Aktywuj w opcjach Clementine."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga não possível. Ative-a nas definições do Clementine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Donwload não autorizado. Ative nas configurações do Clementine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка запрещена. Активируйте функцию в настройках Clementine."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Preberanie je zakázané. Aktivujte ho v nastaveniach prehrávača Clementine."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Преузимање није дозвољено. Активирајте га у поставкама Клементине."
          }
        },
        "sv": {
